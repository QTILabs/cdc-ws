# =============================================================================
# CDC Workspace — Docker Build Context
# Rules are evaluated from top to bottom; later rules override earlier ones.
# Keep this list minimal — every extra line = more COPY work = slower builds.
# =============================================================================

# ── Build artifacts ────────────────────────────────────────────────────────────
# Rust incremental compiles + generated code (rebuilt from Cargo.lock + source)
target/

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Web Console (separate Dockerfile) ───────────────────────────────────────
# cargo-chef & Rust builder do NOT need the Node.js project.
# cdc-web-console/ is built by its own docker/Dockerfile separately.
cdc-web-console/

# ── Caches ──────────────────────────────────────────────────────────────────
**/.cache/
**/.parcel-cache/
**/.turbo/
**/.vite/

# ── Temporary ────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig

# ── Secrets / local config (should be mounted via env_file or volume) ─────────
.env
!.env.example
